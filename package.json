{
  "name": "recoai",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "extensions/*"
  ],
  "scripts": {
    "build": "npm run db:generate && npm run build --workspace=apps/web",
    "dev": "npm run dev --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "db:generate": "dotenv -e .env -- npm run db:generate --workspace=packages/database",
    "db:migrate": "dotenv -e .env -- npm run db:migrate --workspace=packages/database",
    "db:migrate:dev": "dotenv -e .env -- npm run db:migrate:dev --workspace=packages/database",
    "db:seed": "dotenv -e .env -- npm run db:seed --workspace=packages/database",
    "shopify": "shopify"
  },
  "devDependencies": {
    "@shopify/cli": "4.6.0",
    "dotenv-cli": "^8.0.0"
  },
  "overrides": {
    "@graphql-tools/url-loader": "8.0.16",
    "@graphql-codegen/client-preset": "4.7.0",
    "@graphql-codegen/typescript-operations": "4.5.0",
    "minimatch": "9.0.5",
    "vite": "^6.2.2"
  }
}
