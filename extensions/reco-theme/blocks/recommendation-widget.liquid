{% comment %}
  Generic RecoAI recommendations block — choose placement type manually.
  Prefer the page-specific blocks (You may also like, Trending now, etc.) when available.
{% endcomment %}
{% assign placement = block.settings.placement_type | default: 'product_page' %}
{% case placement %}
  {% when 'product_page' %}
    {% assign placement_key = 'product_you_may_also_like' %}
    {% assign strategy = 'content_similarity' %}
  {% when 'cart' %}
    {% assign placement_key = 'cart' %}
    {% assign strategy = 'association_rules' %}
  {% when 'home' %}
    {% assign placement_key = 'home_trending' %}
    {% assign strategy = 'trending' %}
  {% when 'collection' %}
    {% assign placement_key = 'collection' %}
    {% assign strategy = 'content_similarity' %}
  {% when 'search' %}
    {% assign placement_key = 'search' %}
    {% assign strategy = 'trending' %}
  {% else %}
    {% assign placement_key = placement %}
    {% assign strategy = 'trending' %}
{% endcase %}

{% render 'reco-widget-root',
  block: block,
  placement_type: placement,
  placement_key: placement_key,
  strategy: strategy
%}

{% schema %}
{
  "name": "t:recommendation_widget.name",
  "target": "section",
  "stylesheet": "reco-widget.css",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:recommendation_widget.info"
    },
    {
      "type": "text",
      "id": "api_url",
      "label": "t:shared.settings.api_url.label",
      "info": "t:shared.settings.api_url.info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.settings.heading.label",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "item_count",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "t:shared.settings.item_count.label",
      "default": 4
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:shared.settings.layout.label",
      "options": [
        {
          "value": "grid",
          "label": "t:shared.settings.layout.options.grid"
        },
        {
          "value": "carousel",
          "label": "t:shared.settings.layout.options.carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:shared.settings.columns.label",
      "info": "t:shared.settings.columns.info",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "placement_type",
      "label": "t:recommendation_widget.settings.placement_type.label",
      "options": [
        {
          "value": "product_page",
          "label": "t:recommendation_widget.settings.placement_type.options.product_page"
        },
        {
          "value": "cart",
          "label": "t:recommendation_widget.settings.placement_type.options.cart"
        },
        {
          "value": "home",
          "label": "t:recommendation_widget.settings.placement_type.options.home"
        },
        {
          "value": "collection",
          "label": "t:recommendation_widget.settings.placement_type.options.collection"
        },
        {
          "value": "search",
          "label": "t:recommendation_widget.settings.placement_type.options.search"
        }
      ],
      "default": "product_page"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:shared.settings.show_price.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_atc",
      "label": "t:shared.settings.show_atc.label",
      "default": false
    }
  ]
}
{% endschema %}
