{{ 'reco-widget.css' | asset_url | stylesheet_tag }}

<div
  id="RecoAI-{{ block.id }}"
  class="recoai-block"
  data-recoai-widget
  data-shop="{{ shop.permanent_domain | escape }}"
  data-api-url="{{ block.settings.api_url | escape }}"
  data-placement-type="{{ block.settings.placement_type | escape }}"
  data-heading="{{ block.settings.heading | escape }}"
  data-item-count="{{ block.settings.item_count }}"
  data-layout="{{ block.settings.layout | escape }}"
  data-columns="{{ block.settings.columns }}"
  data-show-price="{% if block.settings.show_price %}true{% else %}false{% endif %}"
  data-show-atc="{% if block.settings.show_atc %}true{% else %}false{% endif %}"
  data-money-format="{{ shop.money_format | escape }}"
  data-product-id="{% if product %}{{ product.id }}{% endif %}"
  data-collection-id="{% if collection %}{{ collection.id }}{% endif %}"
  data-search-query="{{ search.terms | default: '' | escape }}"
  data-page-type="{{ request.page_type | escape }}"
  hidden
  {{ block.shopify_attributes }}
>
  <div class="recoai-block__inner">
    <h2 class="recoai-block__heading">{{ block.settings.heading | escape }}</h2>
    <div class="recoai-block__content" data-recoai-content></div>
  </div>
</div>

{% unless recoai_widget_assets %}
  {% assign recoai_widget_assets = true %}
  <script src="{{ 'reco-widget.js' | asset_url }}" defer></script>
{% endunless %}

{% schema %}
{
  "name": "t:recommendation_widget.name",
  "target": "section",
  "stylesheet": "reco-widget.css",
  "settings": [
    {
      "type": "text",
      "id": "api_url",
      "label": "t:recommendation_widget.settings.api_url.label",
      "info": "t:recommendation_widget.settings.api_url.info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:recommendation_widget.settings.heading.label",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "item_count",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "t:recommendation_widget.settings.item_count.label",
      "default": 4
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:recommendation_widget.settings.layout.label",
      "options": [
        {
          "value": "grid",
          "label": "t:recommendation_widget.settings.layout.options.grid"
        },
        {
          "value": "carousel",
          "label": "t:recommendation_widget.settings.layout.options.carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:recommendation_widget.settings.columns.label",
      "info": "t:recommendation_widget.settings.columns.info",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "placement_type",
      "label": "t:recommendation_widget.settings.placement_type.label",
      "options": [
        {
          "value": "product_page",
          "label": "t:recommendation_widget.settings.placement_type.options.product_page"
        },
        {
          "value": "cart",
          "label": "t:recommendation_widget.settings.placement_type.options.cart"
        },
        {
          "value": "home",
          "label": "t:recommendation_widget.settings.placement_type.options.home"
        },
        {
          "value": "collection",
          "label": "t:recommendation_widget.settings.placement_type.options.collection"
        },
        {
          "value": "search",
          "label": "t:recommendation_widget.settings.placement_type.options.search"
        }
      ],
      "default": "product_page"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:recommendation_widget.settings.show_price.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_atc",
      "label": "t:recommendation_widget.settings.show_atc.label",
      "default": false
    }
  ]
}
{% endschema %}
