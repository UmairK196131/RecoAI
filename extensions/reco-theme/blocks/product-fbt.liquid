{% comment %}
  Product page — Frequently bought together (association rules default).
  Add in Theme Editor → Product pages → Add block → RecoAI: Bought together
{% endcomment %}
{% render 'reco-widget-root',
  block: block,
  placement_type: 'product_page',
  placement_key: 'product_frequently_bought_together',
  strategy: 'association_rules'
%}

{% schema %}
{
  "name": "t:product_fbt.name",
  "target": "section",
  "templates": ["product"],
  "stylesheet": "reco-widget.css",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:product_fbt.info"
    },
    {
      "type": "text",
      "id": "api_url",
      "label": "t:shared.settings.api_url.label",
      "info": "t:shared.settings.api_url.info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:shared.settings.heading.label",
      "default": "Frequently bought together"
    },
    {
      "type": "range",
      "id": "item_count",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "t:shared.settings.item_count.label",
      "default": 3
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:shared.settings.layout.label",
      "options": [
        { "value": "grid", "label": "t:shared.settings.layout.options.grid" },
        { "value": "carousel", "label": "t:shared.settings.layout.options.carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:shared.settings.columns.label",
      "info": "t:shared.settings.columns.info",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:shared.settings.show_price.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_atc",
      "label": "t:shared.settings.show_atc.label",
      "default": true
    }
  ]
}
{% endschema %}
