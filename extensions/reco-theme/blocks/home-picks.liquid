{% comment %}
  Home page — Picks for you (personalized blend / session-aware).
  Add in Theme Editor → Home page → Add block → RecoAI: Picks for you
{% endcomment %}
{% render 'reco-widget-root',
  block: block,
  placement_type: 'home',
  placement_key: 'home_picks_for_you',
  strategy: 'personalized_blend'
%}

{% schema %}
{
  "name": "t:home_picks.name",
  "target": "section",
  "templates": ["index"],
  "stylesheet": "reco-widget.css",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:home_picks.info"
    },
    {
      "type": "text",
      "id": "api_url",
      "label": "t:home_picks.settings.api_url.label",
      "info": "t:home_picks.settings.api_url.info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:home_picks.settings.heading.label",
      "default": "Picks for you"
    },
    {
      "type": "range",
      "id": "item_count",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "t:home_picks.settings.item_count.label",
      "default": 4
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:home_picks.settings.layout.label",
      "options": [
        { "value": "grid", "label": "t:home_picks.settings.layout.options.grid" },
        { "value": "carousel", "label": "t:home_picks.settings.layout.options.carousel" }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:home_picks.settings.columns.label",
      "info": "t:home_picks.settings.columns.info",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:home_picks.settings.show_price.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_atc",
      "label": "t:home_picks.settings.show_atc.label",
      "default": false
    }
  ]
}
{% endschema %}
