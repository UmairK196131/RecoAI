# Shopify App
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,read_orders,read_customers,read_inventory,read_content
# SHOPIFY_APP_URL is set automatically by Shopify CLI during `npm run dev`

# Database (PostgreSQL 15 + pgvector via docker compose)
DATABASE_URL=postgresql://recoai:recoai@localhost:5432/recoai

# Redis (via docker compose)
REDIS_URL=redis://localhost:6379

# Token encryption (AES-256-GCM) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Optional: custom shop domain for development
# SHOP_CUSTOM_DOMAIN=
